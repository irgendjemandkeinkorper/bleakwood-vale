rules_version = '2';

// Fog-of-war schema for Blackwood Vale remote multiplayer:
//   rooms/{roomCode}                 – public game state, readable by any
//                                      signed-in (anonymous) participant.
//                                      `seats` is a MAP KEYED BY UID (not an
//                                      array) so membership is expressible
//                                      here as `uid in resource.data.seats`.
//   rooms/{roomCode}/private/{uid}   – that player's hand + Hidden Sin(s),
//                                      readable/writable only by that uid.
//
// Known, accepted limitation: without a Cloud Function, these rules can
// verify WHO is writing to the public room doc (a seated participant) but
// not the full SHAPE of the write (e.g. that they aren't setting their own
// scenesLeft to 99). This mirrors the game's existing "trust the table"
// design — the whole ruleset already runs on that same trust via the Strike
// mechanic — so it's a deliberate tradeoff for staying serverless rather
// than a bug to chase down. Revisit with a Cloud Function if that trust
// model ever needs tightening.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      // Either you're already a seated participant, or your write is the
      // one adding you as a new seat (joining the lobby).
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.seats
                        || request.auth.uid in request.resource.data.seats);

      allow create: if request.auth != null; // hosting a brand-new room
      allow delete: if false;                // reaped via Firestore TTL policy, not client code
    }

    match /rooms/{roomCode}/private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
